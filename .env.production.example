# ============================================================================
# Shadow : Helix Nebula (SHN) — Production Environment Template (.env.production.example)
#
# Copy to .env.production or export in container orchestrator / CI/CD pipeline.
# Generate strong, distinct 32+ character entropy keys for all secrets.
# ============================================================================

# Environment Mode (Enforces strict security invariants fail-closed)
NODE_ENV=production

# HTTP Gateway & Web Console Binding
SHN_PORT=8080
SHN_HOST=0.0.0.0

# Database Configuration (PostgreSQL 17 Primary Cluster)
SHN_DB_HOST=postgres
SHN_DB_PORT=5432
SHN_DB_NAME=shn_primary
SHN_DB_USER=shn_app
# Generate with: openssl rand -base64 32
SHN_DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD_MIN_32_CHARS
SHN_DB_SSL=false

# Connection Pool Settings
SHN_DB_MAX_CONNECTIONS=20
SHN_DB_MIN_CONNECTIONS=4
SHN_DB_IDLE_TIMEOUT_MS=10000
SHN_DB_CONNECTION_TIMEOUT_MS=5000

# Cryptographic Signer Secrets (HMAC-SHA256, minimum 32 chars)
# Generate with: openssl rand -hex 32
SHN_SIGNER_SECRET=REPLACE_WITH_UNIQUE_SIGNER_SECRET_KEY_MIN_32_BYTES_HEX
SHN_SCOPE_SIGNER_SECRET=REPLACE_WITH_UNIQUE_SCOPE_SIGNER_SECRET_MIN_32_BYTES_HEX

# Sovereign Operator Initial Master Provisioning
# If left blank, SHN automatically generates a secure 24-character random password
# and stores it in .shn-initial-credentials with 0600 file permissions.
# Or provide an explicit master password (minimum 8 characters, recommended 16+):
SHN_INITIAL_ADMIN_EMAIL=operator@shn.sovereign
SHN_INITIAL_ADMIN_PASSWORD=REPLACE_WITH_SECURE_INITIAL_OPERATOR_PASSWORD
