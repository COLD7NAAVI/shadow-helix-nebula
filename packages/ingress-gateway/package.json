{
  "name": "@shn/ingress-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Shadow : Helix Nebula (SHN) — Ingress API Gateway & Sovereign CLI (Stage 8)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "shn": "./bin/shn.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --build",
    "test:unit": "node --test test/unit/**/*.test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/**/*.test.ts",
    "test": "node --test test/unit/**/*.test.ts && node --test --test-concurrency=1 test/integration/**/*.test.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@shn/asset-inventory": "*",
    "@shn/auth-rbac": "*",
    "@shn/capability-registry": "*",
    "@shn/data-access": "*",
    "@shn/error-catalog": "*",
    "@shn/event-bus": "*",
    "@shn/execution-supervisor": "*",
    "@shn/scope-gatekeeper": "*",
    "@shn/shared-kernel": "*",
    "@shn/telemetry": "*",
    "@types/node": "^26.6.2",
    "typescript": "^5.9.3"
  }
}
