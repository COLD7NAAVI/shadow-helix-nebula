# Shadow : Helix Nebula (SHN) — Database Environment Configuration Example
# Copy to .env or export into process environment. Never commit production credentials.

# Mode 1: Unified PostgreSQL Connection URL (takes precedence when defined)
# SHN_DATABASE_URL=postgresql://shn_user:your_secret_password@127.0.0.1:5432/shn_primary?sslmode=disable

# Mode 2: Discrete Configuration Parameters
SHN_DB_HOST=127.0.0.1
SHN_DB_PORT=5432
SHN_DB_NAME=shn_primary
SHN_DB_USER=shn_app
SHN_DB_PASSWORD=your_secure_db_password_here
SHN_DB_SSL=false

# Connection Pool & Timeout Parameters
SHN_DB_MAX_CONNECTIONS=20
SHN_DB_MIN_CONNECTIONS=2
SHN_DB_IDLE_TIMEOUT_MS=10000
SHN_DB_CONNECTION_TIMEOUT_MS=5000

# Testing Environment Overrides
SHN_TEST_DB_HOST=127.0.0.1
SHN_TEST_DB_PORT=54329
SHN_TEST_DB_NAME=shn_test
SHN_TEST_DB_USER=postgres
# SHN_TEST_DB_PASSWORD=
