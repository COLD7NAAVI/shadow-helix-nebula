# ============================================================================
# Shadow : Helix Nebula (SHN) — Development Environment Template (.env.example)
#
# Copy to .env for local development. Never commit real production secrets.
# ============================================================================

# Environment Mode
NODE_ENV=development

# HTTP Gateway & Web Console Binding
SHN_PORT=8080
SHN_HOST=0.0.0.0

# Database Configuration (Development / Local Test Cluster)
SHN_DB_HOST=127.0.0.1
SHN_DB_PORT=54329
SHN_DB_NAME=shn_test
SHN_DB_USER=postgres
SHN_DB_PASSWORD=postgres_test_password
SHN_DB_SSL=false

# Connection Pool Settings
SHN_DB_MAX_CONNECTIONS=10
SHN_DB_MIN_CONNECTIONS=2
SHN_DB_IDLE_TIMEOUT_MS=10000
SHN_DB_CONNECTION_TIMEOUT_MS=5000

# Cryptographic Signer Secrets (HMAC-SHA256, minimum 32 chars)
SHN_SIGNER_SECRET=shn-development-signer-secret-key-32b!
SHN_SCOPE_SIGNER_SECRET=shn-development-scope-secret-key-32b!

# Initial Sovereign Operator Provisioning
SHN_INITIAL_ADMIN_EMAIL=operator@shn.sovereign
SHN_INITIAL_ADMIN_PASSWORD=Password123!
